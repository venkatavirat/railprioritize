# RailPrioritize — copy to .env.local and fill in.

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio → API keys (used by /api/optimize-schedule)
GEMINI_API_KEY=

# Optional server-only key; bypasses RLS for optimiser writes.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "true" to auto-sign-in as the default planner during local dev.
# Has no effect when NODE_ENV=production.
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
